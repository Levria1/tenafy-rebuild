# ============================================================
# Tenafy Rebuild - Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (MySQL) ---
# Variable names must match exactly — code reads these in config/index.js
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_DATABASE=tena_prod

# --- JWT Auth ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=24h

# --- Frontend URL (for CORS + email links) ---
FRONTEND_URL=http://localhost:3000

# --- Public App URL (used when rendering links inside emails, e.g. booking confirmations) ---
# Defaults to FRONTEND_URL if unset. Set this explicitly when the user-facing host differs
# from the internal frontend dev URL (e.g. a public domain behind a reverse proxy).
APP_URL=http://localhost:3000

# --- Public backend origin for Airbnb iCal feeds ---
# Must be the externally reachable API origin because Airbnb fetches this URL.
# If unset, /api/ical/tokens builds URLs from the incoming request host.
PUBLIC_BASE_URL=

# --- Email (Nodemailer) ---
# Leave blank in dev — will use Ethereal test account (preview URL logged to console)
# Fill in for production SMTP:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@yourdomain.com

# --- File Storage ---
# Path to legacy file storage from the original Tenafy (AWS Backup).
# REQUIRED wherever legacy files exist — 84% of `file` rows on production point at
# them, and a wrong path silently breaks every legacy photo / ID scan / document
# ("File not found"). On the production droplet the files were left in place by the
# old Java app rather than copied, so both systems share the directory:
#   LEGACY_STORAGE_DIR=/var/www/tane/storage
# Verify by fetching a real legacy file through /api/file/preview/<id>, not by
# reading the config. See DEPLOY-GUIDE.md -> "Legacy files".
LEGACY_STORAGE_DIR=

# --- Chatbot / LLM ---
# Set CHAT_ENABLED=false to globally disable the chatbot (emergency kill).
CHAT_ENABLED=true
LLM_PROVIDER=minimax
CHAT_MAX_TOOL_ITERATIONS=6

# MiniMax API credentials (get from https://www.minimaxi.chat)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# --- WordPress calendar bridge (tenafy-wp-bridge) ---
# When a lease becomes active / is cancelled, Tenafy fires a fire-and-forget
# webhook to the Python bridge, which blocks/unblocks the WP Booking System
# calendar. Leave URL/SECRET blank to disable (no-op).
TENAFY_WP_WEBHOOK_URL=
TENAFY_WP_WEBHOOK_SECRET=
# Only fire for this org (the one whose units are in the bridge's units.csv).
# Tane Residence = 8300127259922432. Leave blank to fire for all orgs.
TENAFY_WP_WEBHOOK_ORG_ID=8300127259922432

# Viewing relay stale-negotiation cadence (hourly cron, so the reminder lands in
# [VIEWING_REMINDER_HOURS, +1h)). The reminder MUST be lower than the stale window
# or it can never fire — the service warns at boot if they cross.
VIEWING_REMINDER_HOURS=4
VIEWING_STALE_HOURS=24
