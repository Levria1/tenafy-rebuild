{
  "manifest_version": 3,
  "name": "Tenafy Reconciliation Review",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "Open Tenafy reconciliation review"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "optional_host_permissions": [
    "https://platform.tenafy.com/*"
  ]
}
